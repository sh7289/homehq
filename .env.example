# Copy to /home/homehq/.homehq.env on the server (or a local .env for dev)
# and fill in real values. Never commit the real file.

# Flask session-signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Two household accounts. Generate each password hash with:
#   python3 -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
HOMEHQ_USER1_NAME=
HOMEHQ_USER1_HASH=
HOMEHQ_USER2_NAME=
HOMEHQ_USER2_HASH=

# Where the markdown catalog and photos live.
HOMEHQ_CONTENT_DIR=/home/homehq/homehq/content
HOMEHQ_PHOTOS_DIR=/home/homehq/homehq/photos

# SQLite database file for the pantry.
HOMEHQ_DB_PATH=/home/homehq/homehq/pantry.db

# Where uploaded receipt/item photos are staged before AI extraction.
HOMEHQ_UPLOADS_DIR=/home/homehq/homehq/uploads

# Set to "true" once nginx is terminating TLS in front of this app (enables
# Secure session cookies and trusts X-Forwarded-* headers). Leave unset for
# local HTTP dev.
HOMEHQ_BEHIND_TLS_PROXY=

# Optional: only needed to run scripts/export_to_sheets.py
HOMEHQ_GOOGLE_SERVICE_ACCOUNT_FILE=
HOMEHQ_GOOGLE_SHEET_ID=

# Optional: only needed for the /import photo-upload AI extraction feature.
# Use a key dedicated to Home HQ, separate from any other app's.
HOMEHQ_ANTHROPIC_API_KEY=

# Optional: only needed to let approved catalog imports auto-commit+push.
# A GitHub fine-grained PAT scoped to ONLY this repo, "Contents: write"
# permission and nothing else. Leave unset to just write the file locally
# on the server without pushing (you'd git add/commit/push it yourself).
HOMEHQ_GITHUB_TOKEN=
