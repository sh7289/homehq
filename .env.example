# Copy to /home/homehq/.homehq.env on the server (or a local .env for dev)
# and fill in real values. Never commit the real file.

# Flask session-signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Two household accounts. Generate each password hash with:
#   python3 -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
HOMEHQ_USER1_NAME=
HOMEHQ_USER1_HASH=
HOMEHQ_USER2_NAME=
HOMEHQ_USER2_HASH=

# Where the markdown catalog and photos live.
HOMEHQ_CONTENT_DIR=/home/homehq/homehq/content
HOMEHQ_PHOTOS_DIR=/home/homehq/homehq/photos

# SQLite database file for the pantry.
HOMEHQ_DB_PATH=/home/homehq/homehq/pantry.db

# Optional: only needed to run scripts/export_to_sheets.py
HOMEHQ_GOOGLE_SERVICE_ACCOUNT_FILE=
HOMEHQ_GOOGLE_SHEET_ID=
